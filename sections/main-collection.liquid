{% comment %}
  Main Collection Section - Stratos Theme
  Interactive collection layout with column density switchers (2, 3, 4 cols), dual-axis filters, and INR currency formatting.
{% endcomment %}

<section class="collection-section">
  <div class="container">
    
    <!-- Hero Header -->
    <div class="collection-hero">
      <h1 class="collection-title font-sans">
        {{ collection.title | default: 'Catalogue' }}
      </h1>
      <p class="collection-subtitle">
        {{ collection.description | default: 'Curated essentials across T-Shirts, Hoodies, and Sweatpants. Categorized by Casual, Polo, Oversized, and Essential fits in certified organic fabrics.' }}
      </p>
    </div>

    <!-- Filter, Sort & Column Toolbar -->
    <div class="collection-filter-bar">
      <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
        
        <!-- Primary Type Filter Tabs -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
          <div class="filter-pills-group" role="tablist" aria-label="Garment Type Categories">
            <button type="button" class="filter-pill is-active" data-filter-type="all">ALL GARMENTS (6)</button>
            <button type="button" class="filter-pill" data-filter-type="t-shirt">T-SHIRTS (3)</button>
            <button type="button" class="filter-pill" data-filter-type="hoodies">HOODIES (2)</button>
            <button type="button" class="filter-pill" data-filter-type="sweatpants">SWEATPANTS (1)</button>
          </div>

          <div style="display: flex; align-items: center; gap: var(--spacing-sm); flex-wrap: wrap;">
            <!-- Column Density & Axis Controls -->
            <div class="grid-col-switchers" aria-label="Grid Column Layout">
              <span style="font-size: 0.65rem; font-weight: 700; color: var(--color-text-subtle); padding-inline: 0.35rem;">LAYOUT:</span>
              <button type="button" class="grid-col-btn" data-grid-cols="2" title="2 Large Columns">2</button>
              <button type="button" class="grid-col-btn is-active" data-grid-cols="3" title="3 Standard Columns">3</button>
              <button type="button" class="grid-col-btn" data-grid-cols="4" title="4 Dense Columns">4</button>
              <button type="button" class="grid-col-btn" data-grid-cols="axis" title="Horizontal Axis Slider">↔ AXIS</button>
            </div>

            <!-- Sort Select -->
            <div class="sort-select-wrapper">
              <label for="SortBy">Sort:</label>
              <select id="SortBy" class="sort-select">
                <option value="featured">Featured</option>
                <option value="price-ascending">Price: Low to High</option>
                <option value="price-descending">Price: High to Low</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Secondary Style / Category Sub-filter Pills -->
        <div class="category-subfilters-group" role="tablist" aria-label="Style Fit Categories">
          <span style="font-size: 0.65rem; font-weight: 700; color: #7E3E25; text-transform: uppercase;">STYLE FIT:</span>
          <button type="button" class="subfilter-pill is-active" data-filter-category="all">ALL STYLES</button>
          <button type="button" class="subfilter-pill" data-filter-category="casual">CASUAL (1)</button>
          <button type="button" class="subfilter-pill" data-filter-category="polo">POLO (1)</button>
          <button type="button" class="subfilter-pill" data-filter-category="oversized">OVERSIZED (2)</button>
          <button type="button" class="subfilter-pill" data-filter-category="essential">ESSENTIAL (2)</button>
        </div>

      </div>
    </div>

    <!-- Product Grid -->
    <div class="product-grid {{ section.settings.default_grid_columns | default: 'grid-cols-3' }}" id="ProductGridContainer">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <!-- 01. Casual T-Shirt -->
        <div class="product-card" data-product-handle="casual-t-shirt" data-type="t-shirt" data-category="casual" data-price="599">
          <div class="product-card-media" aria-label="Casual T-Shirt image gallery">
            <div class="card-carousel-track" data-current-slide="0" onclick="selectCatalogueProduct('casual-t-shirt')">
              <div class="card-carousel-slide"><img src="assets/images/offwhite_casual_t-shirt_1.png" alt="Casual T-Shirt Off White"></div>
              <div class="card-carousel-slide"><img src="assets/images/beige_casual_t-shirt_1.png" alt="Casual T-Shirt Beige"></div>
              <div class="card-carousel-slide"><img src="assets/images/jade_casual_t-shirt_1.png" alt="Casual T-Shirt Jade"></div>
              <div class="card-carousel-slide"><img src="assets/images/coral_casual_t-shirt_1.png" alt="Casual T-Shirt Coral"></div>
            </div>
            <button type="button" class="card-carousel-btn card-carousel-prev" onclick="cardCarouselPrev(event, 'casual-t-shirt')" aria-label="Previous view"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
            <button type="button" class="card-carousel-btn card-carousel-next" onclick="cardCarouselNext(event, 'casual-t-shirt')" aria-label="Next view"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            <div class="card-carousel-dots"><button type="button" class="card-carousel-dot is-active" onclick="cardCarouselGoTo(event, 'casual-t-shirt', 0)"></button><button type="button" class="card-carousel-dot" onclick="cardCarouselGoTo(event, 'casual-t-shirt', 1)"></button><button type="button" class="card-carousel-dot" onclick="cardCarouselGoTo(event, 'casual-t-shirt', 2)"></button><button type="button" class="card-carousel-dot" onclick="cardCarouselGoTo(event, 'casual-t-shirt', 3)"></button></div>
          </div>
          <div class="product-card-info">
            <div class="product-card-category-tag">POPULAR · T-SHIRT · CASUAL</div>
            <a href="javascript:void(0)" onclick="selectCatalogueProduct('casual-t-shirt')" class="product-card-title">Casual T-Shirt</a>
            <div class="product-card-price">₹599</div>
            <div class="product-card-sizes">XS • S • M • L • XL • XXL</div>
            <div class="product-card-swatches">
              <span class="mini-swatch" style="background-color: #F5F2EB;" title="Off White" onmouseenter="cardCarouselGoTo(event, 'casual-t-shirt', 0)" onclick="selectCatalogueProductVariant('casual-t-shirt', 'Off White')"></span>
              <span class="mini-swatch" style="background-color: #E6DCC6;" title="Beige" onmouseenter="cardCarouselGoTo(event, 'casual-t-shirt', 1)" onclick="selectCatalogueProductVariant('casual-t-shirt', 'Beige')"></span>
              <span class="mini-swatch" style="background-color: #ABCDBC;" title="Jade" onmouseenter="cardCarouselGoTo(event, 'casual-t-shirt', 2)" onclick="selectCatalogueProductVariant('casual-t-shirt', 'Jade')"></span>
              <span class="mini-swatch" style="background-color: #FF7B6E;" title="Coral" onmouseenter="cardCarouselGoTo(event, 'casual-t-shirt', 3)" onclick="selectCatalogueProductVariant('casual-t-shirt', 'Coral')"></span>
            </div>
