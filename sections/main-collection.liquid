  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "select",
      "id": "default_grid_columns",
      "label": "Default Desktop Column Count",
      "options": [
        { "value": "grid-cols-2", "label": "2 Columns (Editorial)" },
        { "value": "grid-cols-3", "label": "3 Columns (Standard Balanced)" },
        { "value": "grid-cols-4", "label": "4 Columns (High Density)" }
      ],
      "default": "grid-cols-3"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable Category Filter Pills",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable Sorting Dropdown",
