<div class="editorial-video-hero">
  
  {%- if section.settings.video_url != blank -%}
    <video 
      class="editorial-video-hero__video" 
      autoplay 
      loop 
      muted 
      playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  {%- else -%}
    <!-- Placeholder if no video is uploaded -->
    <div class="editorial-video-hero__placeholder">
      <p>Please add an MP4 video URL in the section settings.</p>
    </div>
  {%- endif -%}

  <!-- Dark overlay to make text readable -->
  <div class="editorial-video-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="editorial-video-hero__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="editorial-video-hero__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.button_link != blank and section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="editorial-video-hero__button">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Editorial Video",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "MP4 Video URL",
      "info": "Upload your MP4 to Settings > Files in Shopify, then paste the URL here."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30,
      "info": "Darkens the video so your text and button are easier to read."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Season Arrivals"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Catalogue"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Editorial Video",
      "category": "Video"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.editorial-video-hero {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9; /* Desktop Widescreen Ratio */
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Updated video targeting for perfect native fitting */
.editorial-video-hero__video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.editorial-video-hero__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000000;
  z-index: 2;
}

.editorial-video-hero__placeholder {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background-color: #f4f4f4;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  color: #333;
}

.editorial-video-hero__content {
  position: relative;
  z-index: 3;
  text-align: center;
  padding: 0 20px;
  color: #ffffff;
}

.editorial-video-hero__heading {
  font-size: 3.5rem;
  margin-bottom: 30px;
  color: #ffffff;
  letter-spacing: 1px;
}

.editorial-video-hero__button {
  display: inline-block;
  background-color: #ffffff;
  color: #000000;
  padding: 15px 35px;
  font-size: 1.1rem;
  text-decoration: none;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: background-color 0.3s ease, transform 0.2s ease;
}

.editorial-video-hero__button:hover {
  background-color: #f0f0f0;
  transform: translateY(-2px);
}

/* Mobile adjustments */
@media screen and (max-width: 768px) {
  .editorial-video-hero {
    aspect-ratio: 9 / 16; /* Mobile Vertical Ratio */
  }
  
  .editorial-video-hero__heading {
    font-size: 2.2rem;
  }
  
  .editorial-video-hero__button {
    padding: 12px 25px;
    font-size: 1rem;
  }
}
{% endstylesheet %}