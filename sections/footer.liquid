{% comment %}
  Footer Section - Stratos Theme
  Customizable Multi-Column Editorial Footer (3 or 4 Columns).
  Features: Brand narrative, newsletter subscribe box, catalogue links, shipping policies, and a Support Popup.
{% endcomment %}

<style>
  /* Custom popup styling matching the Faberelin aesthetic */
  .support-popup-btn {
    background-color: transparent;
    color: #7E481C;
    border: 1px solid #7E481C;
    padding: 10px 24px;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    border-radius: 50px;
    transition: background-color 0.3s ease, color 0.3s ease;
    margin-top: 10px;
  }

  .support-popup-btn:hover {
    background-color: #7E481C;
    color: #F5F5DC;
  }

  /* Modal Background Overlay */
  .support-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .support-modal.is-open {
    display: flex;
    opacity: 1;
  }

  /* Modal Content Box */
  .support-modal-content {
    background-color: #F5F5DC;
    color: #7E481C;
    padding: 40px;
    border-radius: 12px;
    width: 90%;
    max-width: 400px;
    position: relative;
    text-align: center;
    transform: translateY(20px);
    transition: transform 0.3s ease;
  }

  .support-modal.is-open .support-modal-content {
    transform: translateY(0);
  }

  /* Close Button (X) */
  .support-modal-close {
    position: absolute;
    top: 15px;
    right: 20px;
    color: #7E481C;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .support-modal-close:hover {
    opacity: 0.6;
  }

  /* Popup Links List */
  .popup-links-list {
    list-style: none;
    padding: 0;
    margin-top: 25px;
  }

  .popup-links-list li {
    margin: 15px 0;
  }

  .popup-links-list a {
    color: #7E481C;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .popup-links-list a:hover {
    opacity: 0.6;
  }
</style>

<footer class="site-footer" id="SiteFooter">
  <div class="container">
    
    <div class="footer-grid {{ section.settings.footer_columns | default: 'cols-4' }}" id="FooterGridContainer">
      
      <!-- 01. Column: Newsletter -->
      <div class="footer-col">
        <h4 class="footer-col-title">{{ section.settings.col_1_title | default: 'NEWSLETTER' }}</h4>
        <p class="footer-col-text">
          {{ section.settings.col_1_text | default: 'Subscribe to receive exclusive access to limited edition textile drops, seasonal lookbooks, and atelier stories.' }}
        </p>
        <form class="newsletter-form" action="/contact#contact_form" method="post">
          <input
            type="email"
            name="contact[email]"
            class="newsletter-input"
            placeholder="Your email address"
            required
            aria-label="Email Address for newsletter"
          >
          <button type="submit" class="newsletter-btn">
            {{ section.settings.newsletter_btn_text | default: 'JOIN' }}
          </button>
        </form>
      </div>

      <!-- 02. Column: Navigation -->
      <div class="footer-col">
        <h4 class="footer-col-title">{{ section.settings.col_2_title | default: 'CATALOGUE ITEMS' }}</h4>
        <ul class="footer-links-list">
          <li><a href="/products/casual-t-shirt" class="footer-link">Casual T-Shirt</a></li>
          <li><a href="/products/polo-t-shirt" class="footer-link">Polo T-Shirt</a></li>
          <li><a href="/products/oversized-t-shirt" class="footer-link">Oversized T-Shirt</a></li>
          <li><a href="/products/essential-hoodie" class="footer-link">Essential Hoodie</a></li>
          <li><a href="/products/oversized-hoodie" class="footer-link">Oversized Hoodie</a></li>
          <li><a href="/products/essential-sweatpants" class="footer-link">Essential Sweatpants</a></li>
        </ul>
      </div>

      <!-- 03. Column: Order Tracking -->
      <div class="footer-col">
        <h4 class="footer-col-title">{{ section.settings.col_3_title | default: 'ORDER TRACKING' }}</h4>
        <p class="footer-col-text">
          {{ section.settings.col_3_text | default: 'Track real-time carbon-neutral shipment progress and carrier dispatch:' }}
        </p>
        <form class="tracking-form" action="/apps/tracking" method="get">
          <input
            type="text"
            name="order_id"
            class="tracking-input"
            placeholder="#FBR-8924"
            required
            aria-label="Order or Tracking Number"
          />
          <button type="submit" class="tracking-btn">
            {{ section.settings.tracking_btn_text | default: 'TRACK' }}
          </button>
        </form>
      </div>

      <!-- 04. Column: Support (Now Triggers Popup) -->
      <div class="footer-col">
        <h4 class="footer-col-title">{{ section.settings.col_4_title | default: 'SUPPORT' }}</h4>
        <p class="footer-col-text">Need help with an order or want to view our policies?</p>
        <button type="button" class="support-popup-btn" id="SupportPopupTrigger">
          View Policies
        </button>
      </div>

    </div>

    <!-- Bottom Copyright & Intentionality Tagline -->
    <div class="footer-bottom-bar">
      <div class="footer-copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'FABERELIN' }}. ALL RIGHTS RESERVED.
      </div>
      <div class="footer-tagline">
        {{ section.settings.bottom_tagline | default: 'DESIGNED FOR INTENTIONALITY.' }}
      </div>
    </div>

  </div>
</footer>

<!-- SUPPORT POPUP MODAL -->
<div id="SupportModal" class="support-modal">
  <div class="support-modal-content">
    <span class="support-modal-close" id="SupportModalClose">&times;</span>
    <h2>{{ section.settings.col_4_title | default: 'SUPPORT & POLICIES' }}</h2>
    <ul class="popup-links-list">
      <li><a href="/pages/contact-us">Contact Us</a></li>
      <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
      <li><a href="/policies/refund-policy">Refund Policy</a></li>
      <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
      <li><a href="/policies/terms-of-service">Terms of Service</a></li>
    </ul>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var modal = document.getElementById("SupportModal");
    var btn = document.getElementById("SupportPopupTrigger");
    var span = document.getElementById("SupportModalClose");

    // Open Modal
    if(btn) {
      btn.onclick = function() {
        modal.classList.add("is-open");
      }
    }

    // Close Modal via X button
    if(span) {
      span.onclick = function() {
        modal.classList.remove("is-open");
      }
    }

    // Close Modal by clicking outside of it
    window.onclick = function(event) {
      if (event.target == modal) {
        modal.classList.remove("is-open");
      }
    }
  });
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "footer_columns",
      "label": "Desktop Column Layout",
      "options": [
        { "value": "cols-4", "label": "4 Columns (Brand, Links, Shipping, Contact)" },
        { "value": "cols-3", "label": "3 Columns (Newsletter, Shipping, Contact)" }
      ],
      "default": "cols-4"
    },
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 Title",
      "default": "NEWSLETTER"
    },
    {
      "type": "textarea",
      "id": "col_1_text",
      "label": "Column 1 Description",
      "default": "Subscribe to receive offers."
    },
    {
      "type": "text",
      "id": "newsletter_btn_text",
      "label": "Newsletter Button Text",
      "default": "JOIN"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "CATALOGUE"
    },
    {
      "type": "text",
      "id": "col_3_title",
      "label": "Column 3 Title",
      "default": "ORDER TRACKING"
    },
    {
      "type": "textarea",
      "id": "col_3_text",
      "label": "Column 3 Description",
      "default": "TRACK YOUR ORDER"
    },
    {
      "type": "text",
      "id": "col_4_title",
      "label": "Column 4 Title",
      "default": "SUPPORT"
    },
    {
      "type": "text",
      "id": "bottom_tagline",
      "label": "Bottom Right Tagline",
      "default": "WHERE HERITAGE MEETS MODERNITY."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}