{% comment %}
  Marquee Banner Section - Stratos Theme
  Infinite 60fps transform ticker with zero reflow and hover pause.
{% endcomment %}

<section class="marquee-section" aria-label="Brand Highlights">
  <div class="marquee-track">
    {%- for i in (1..4) -%}
      <span class="marquee-item">ETHICALLY CRAFTED IN EUROPE</span>
      <span class="marquee-item">100% NORMANDY ORGANIC FLAX LINEN</span>
      <span class="marquee-item">ZERO-REFLOW 60FPS PERFORMANCE</span>
      <span class="marquee-item">FREE CARBON-NEUTRAL DELIVERY OVER $150</span>
      <span class="marquee-item">DESIGNED FOR INTENTIONALITY</span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Marquee Banner",
  "settings": [
    {
      "type": "text",
      "id": "text_items",
      "label": "Marquee Content (Separated by |)",
      "default": "ETHICALLY CRAFTED IN EUROPE | 100% NORMANDY ORGANIC FLAX LINEN | FREE CARBON-NEUTRAL DELIVERY OVER $150"
    }
  ],
  "presets": [
    {
      "name": "Marquee Banner"
    }
  ]
}
{% endschema %}
