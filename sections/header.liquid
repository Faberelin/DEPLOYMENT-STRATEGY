{% comment %}
  Header Section - Stratos Theme
  Minimalist luxury navigation with wordmark, catalog link, search trigger, user account, and cart counter badge.
{% endcomment %}

<header class="site-header" id="SiteHeader">
  <div class="container">
    <div class="header-inner">
      <div class="header-left">
        <a href="/" class="brand-logo" aria-label="{{ shop.name }}">
          <span>{{ section.settings.brand_text | default: 'FABERELIN' }}</span>
        </a>
        <nav class="nav-links" aria-label="Main Navigation">
          {% for link in linklists[section.settings.menu].links %}
            <a href="{{ link.url }}" class="nav-link {% if link.active %}is-active{% endif %}">
              {{ link.title }}
            </a>
          {% else %}
            <a href="/pages/discover" class="nav-link">DISCOVER</a>
            <a href="/collections/all" class="nav-link is-active">CATALOGUE</a>
            <a href="/pages/atelier" class="nav-link">ATELIER</a>
          {% endfor %}
        </nav>
      </div>

      <div class="header-right">
        <!-- Background-Blended Search Bar -->
        <div class="header-search-wrapper">
          <form action="{{ routes.search_url }}" method="get" role="search" class="header-search-bar">
            <svg class="header-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search catalogue..."
              class="header-search-input"
              aria-label="Search garments"
            />
          </form>
        </div>

        <!-- Cart Trigger Button with Dynamic Counter Badge -->
        <button class="icon-btn" data-action="open-cart" aria-label="Shopping Bag ({{ cart.item_count }} items)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-count-badge" id="CartCountBadge">{{ cart.item_count | default: 2 }}</span>
        </button>

        <!-- User Profile Account Button -->
        <a href="/account" class="icon-btn" aria-label="Customer Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Wordmark",
      "default": "FABERELIN"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky Header",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
