{% comment %}
  Main Product Section - Stratos Standard Layout
  Customizable 2-Column Product Layout (Gallery Left / Sticky Info Right).
  Features: Column ratio selector (58/42, 50/50, 68/32), stacked photography, M3 chips, accordions, and schema blocks.
{% endcomment %}

<section class="product-section" data-section-id="{{ section.id }}" data-section-type="product">
  <div class="container">
    <div class="product-layout {{ section.settings.column_ratio | default: 'split-standard' }}" id="ProductLayoutContainer">
      
      <!-- ==========================================
           LEFT COLUMN: INTERACTIVE LUXURY PRODUCT CAROUSEL
           ========================================== -->
      <div class="product-gallery" aria-label="Product Media Gallery">
        <div class="product-carousel-wrapper">
          
          <!-- Main Carousel Stage Viewport (100% Contained, Zero Images Outside) -->
          <div class="product-carousel-viewport" id="ProductCarouselViewport">
            
            <!-- Slide Counter Pill -->
            <div class="carousel-counter-badge" id="CarouselCounterBadge">1 / 4</div>

            <!-- Navigation Arrows -->
            <button type="button" class="carousel-nav-btn carousel-nav-prev" onclick="window.carouselPrev()" aria-label="Previous image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button type="button" class="carousel-nav-btn carousel-nav-next" onclick="window.carouselNext()" aria-label="Next image">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

            <!-- 60fps Sliding Track -->
            <div class="product-carousel-track" id="ProductCarouselTrack">
              
              <!-- Slide 1: Hero Editorial -->
              <div class="product-carousel-slide is-active" data-slide-index="0">
                <img
                  id="ProductHeroImage"
                  src="{{ product.featured_image | default: 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=1200&q=85' }}"
                  alt="{{ product.title | escape }} - Editorial Front Silhouette"
                  width="1200"
                  height="1500"
                  loading="eager"
                  fetchpriority="high"
                >
              </div>

              <!-- Slide 2: Horn Buttons & Tailored French Seams Detail -->
              <div class="product-carousel-slide" data-slide-index="1">
                <img
                  src="{{ section.settings.image_detail_1 | default: 'https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?auto=format&fit=crop&w=1200&q=85' }}"
                  alt="Garment details"
                  width="1200"
                  height="1500"
                  loading="lazy"
                >
              </div>

              <!-- Slide 3: Architectural Silhouette Shot -->
              <div class="product-carousel-slide" data-slide-index="2">
                <img
                  src="{{ section.settings.image_detail_2 | default: 'https://images.unsplash.com/photo-1618354691373-d851c5c3a990?auto=format&fit=crop&w=1200&q=85' }}"
                  alt="Architectural silhouette view"
                  width="1200"
                  height="1500"
                  loading="lazy"
                >
              </div>

              <!-- Slide 4: Organic Normandy Flax Macro Weave -->
              <div class="product-carousel-slide" data-slide-index="3">
                <img
                  src="{{ section.settings.image_macro | default: 'https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=1200&q=85' }}"
                  alt="Fabric texture close-up macro"
                  width="1200"
                  height="1500"
                  loading="lazy"
                >
              </div>

            </div>

            <!-- Internal Pagination Progress Dots -->
            <div class="product-carousel-dots" id="ProductCarouselDots" role="tablist" aria-label="Product Images">
              <button type="button" class="carousel-dot-btn is-active" onclick="window.carouselGoTo(0)" aria-label="View Image 1"></button>
              <button type="button" class="carousel-dot-btn" onclick="window.carouselGoTo(1)" aria-label="View Image 2"></button>
              <button type="button" class="carousel-dot-btn" onclick="window.carouselGoTo(2)" aria-label="View Image 3"></button>
              <button type="button" class="carousel-dot-btn" onclick="window.carouselGoTo(3)" aria-label="View Image 4"></button>
            </div>

          </div>

        </div>

        </div>
      </div>

      <!-- ==========================================
           RIGHT COLUMN: STICKY PURCHASE RAIL
           ========================================== -->
      <div class="product-info-column">
        <div class="product-info-sticky">
          
          <!-- Badge Pill -->
          {%- if section.settings.show_badge -%}
            <span class="product-badge-pill">
              {{ section.settings.badge_text | default: 'NEW ARRIVAL' }}
            </span>
          {%- endif -%}

          <!-- Title -->
          <h1 class="product-title font-sans">
            {{ product.title | default: 'Heritage Linen Overshirt' }}
          </h1>

          <!-- Price -->
          <div class="product-price-wrapper">
            <span class="product-price font-sans">
              {{ product.price | default: 12000 | money }}
            </span>
          </div>

          <!-- Payment Installments Widget (Shop Pay / Klarna) -->
          <div class="product-installments-pill">
            <span>or 4 interest-free payments of <strong>{{ product.price | default: 12000 | divided_by: 4 | money }}</strong> with</span>
            <span class="installments-badge badge-shoppay">Shop Pay</span>
            <span class="installments-badge badge-klarna">Klarna</span>
          </div>

          <!-- Ethical & Quality Badges -->
          <div class="product-badges-row">
            <div class="badge-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span>ETHICALLY SOURCED</span>
            </div>
            <div class="badge-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="8" r="7"/>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
              </svg>
              <span>PREMIUM QUALITY</span>
            </div>
            <div class="badge-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="6" cy="6" r="3"/>
                <circle cx="6" cy="18" r="3"/>
                <line x1="20" y1="4" x2="8.12" y2="15.88"/>
                <line x1="14.47" y1="14.48" x2="20" y2="20"/>
                <line x1="8.12" y1="8.12" x2="12" y2="12"/>
              </svg>
              <span>SUSTAINABLE CRAFT</span>
            </div>
          </div>

          <!-- Product Editorial Description Summary -->
          <p class="product-description-deck">
            {{ product.description | strip_html | truncatewords: 26 | default: 'Meticulously tailored from 100% Normandy organic long-staple flax linen. Features a relaxed dropped-shoulder silhouette, river shell buttons, and French seams.' }}
          </p>

          <!-- Form / Variant Controls -->
          {% form 'product', product, id: 'ProductForm', class: 'product-form' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: 'hlo-sand-m' }}">

            <!-- Color Swatch Selector -->
            <div class="product-option-group">
              <div class="option-header">
                <span class="option-label">COLOR: <strong id="SelectedColorLabel">SAND</strong></span>
              </div>
              <div class="color-swatch-list" role="radiogroup" aria-label="Product Color Options">
                <button type="button" class="swatch-btn swatch-sand is-active" data-swatch-color="Sand" aria-label="Color Sand" title="Sand"></button>
                <button type="button" class="swatch-btn swatch-oat" data-swatch-color="Oat" aria-label="Color Oat" title="Oat"></button>
                <button type="button" class="swatch-btn swatch-charcoal" data-swatch-color="Charcoal" aria-label="Color Charcoal" title="Charcoal"></button>
              </div>
            </div>

            <!-- Size Selector (Google Material Design 3 Chips) -->
            <div class="product-option-group">
              <div class="option-header">
                <span class="option-label">SIZE</span>
                <button type="button" class="size-guide-trigger" data-action="open-size-guide">Size Guide</button>
              </div>
              <div class="size-chip-list" role="radiogroup" aria-label="Product Size Options">
                <button type="button" class="size-chip-btn" data-size-chip="S">S</button>
                <button type="button" class="size-chip-btn is-active" data-size-chip="M">M</button>
                <button type="button" class="size-chip-btn" data-size-chip="L">L</button>
                <button type="button" class="size-chip-btn" data-size-chip="XL">XL</button>
              </div>
            </div>

            <!-- Quantity Selector & Main CTA: Add to Cart with Merged Remover -->
            <div class="cta-wrapper">
              <div class="product-purchase-row" id="ProductPurchaseRow">
                <div class="product-quantity-selector" role="group" aria-label="Product quantity selection">
                  <button type="button" class="qty-selector-btn" id="ProductQtyMinus" data-quantity-change="-1" aria-label="Decrease quantity">−</button>
                  <input
                    type="number"
                    name="quantity"
                    id="ProductQtyInput"
                    class="qty-selector-input"
                    value="1"
                    min="1"
                    max="99"
                    aria-label="Product quantity"
                  />
                  <button type="button" class="qty-selector-btn" id="ProductQtyPlus" data-quantity-change="1" aria-label="Increase quantity">+</button>
                </div>
                <div class="product-cta-group">
                  <button type="submit" name="add" class="btn-primary product-add-btn" id="MainAddToCartBtn" data-action="add-to-cart">
                    <span id="MainAddToCartText">ADD TO CART</span>
                    <span class="btn-price-divider" id="MainAddToCartDivider">•</span>
                    <span class="btn-price-value" id="AddToCartPriceLabel">{{ product.selected_or_first_available_variant.price | default: 12000 | money }}</span>
                  </button>
                  <button type="button" class="btn-remove-from-cart" id="ProductRemoveFromCartBtn" title="Remove this item from bag" aria-label="Remove item from bag" style="display: none;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    <span>REMOVE</span>
                  </button>
                </div>
              </div>
            </div>
          {% endform %}

          <!-- Shipping Notice Card -->
          <div class="shipping-notice-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <div class="shipping-notice-text">
              Free carbon-neutral shipping on orders over $150. Delivery in 3–5 business days.
            </div>
          </div>

          <!-- Guaranteed Payment Gateways & Secure Checkout -->
          <div class="product-payment-gateways">
            <div class="payment-gateways-header">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>GUARANTEED SAFE & ENCRYPTED CHECKOUT</span>
            </div>
            <div class="payment-icons-row">
              <span class="payment-badge-pill pill-upi" title="Unified Payments Interface">UPI</span>
              <span class="payment-badge-pill pill-gpay" title="Google Pay UPI">GPay</span>
              <span class="payment-badge-pill pill-phonepe" title="PhonePe UPI">PhonePe</span>
              <span class="payment-badge-pill pill-paytm" title="Paytm UPI">Paytm</span>
              <span class="payment-badge-pill pill-bhim" title="BHIM UPI">BHIM</span>
              <span class="payment-badge-pill pill-cred" title="CRED Pay">CRED</span>
              <span class="payment-badge-pill pill-rupay" title="RuPay Debit & Credit Cards">RuPay</span>
              <span class="payment-badge-pill pill-visa" title="Visa Cards">VISA</span>
              <span class="payment-badge-pill pill-mc" title="Mastercard">Mastercard</span>
              <span class="payment-badge-pill pill-amex" title="American Express">AMEX</span>
              <span class="payment-badge-pill pill-netbanking" title="Net Banking All Indian Banks">Net Banking</span>
              <span class="payment-badge-pill pill-emi" title="No-Cost EMI on Credit Cards">Card EMI</span>
            </div>
          </div>
        </div>

          <!-- Accordion Drawers -->
          <div class="product-accordion-group">
            
            <!-- 01. Description -->
            <div class="accordion-item is-open">
              <button type="button" class="accordion-trigger" aria-expanded="true">
                <span>DESCRIPTION</span>
                <span class="accordion-icon">+</span>
              </button>
              <div class="accordion-content" style="max-height: 250px;">
                <div class="accordion-body">
                  <p id="ProductAccordionDescription">Meticulously tailored from 100% Normandy long-staple flax linen. The Heritage Linen Overshirt balances a relaxed dropped-shoulder silhouette with refined horn buttons and tailored french seams, creating a transitional wardrobe staple designed for effortless layering across seasons.</p>
                </div>
              </div>
            </div>

            <!-- 02. Fit & Sizing -->
            <div class="accordion-item">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span>FIT & SIZING</span>
                <span class="accordion-icon">+</span>
              </button>
              <div class="accordion-content">
                <div class="accordion-body" id="ProductFitBody">
                  <p id="ProductFitText">Unisex oversized fit – relaxed all around with dropped shoulders for an easygoing look.</p>
                </div>
              </div>
            </div>

            <!-- 03. Materials & Care -->
            <div class="accordion-item">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span>MATERIALS & CARE</span>
                <span class="accordion-icon">+</span>
              </button>
              <div class="accordion-content">
                <div class="accordion-body">
                  <p id="ProductMaterialsText">{{ product.metafields.custom.materials_care | default: '100% cotton with 180 GSM for lightweight comfort.' }}</p>
                </div>
              </div>
            </div>

            <!-- 04. Shipping & Refund Policy -->
            <div class="accordion-item">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span>SHIPPING & REFUND POLICIES</span>
                <span class="accordion-icon">+</span>
              </button>
              <div class="accordion-content">
                <div class="accordion-body">
                  <p><strong>Order Processing:</strong> 1–3 business days after confirmation.</p>
                  <p><strong>Standard Delivery:</strong> 4–7 business days across India.</p>
                  <p><strong>Returns & Refunds:</strong> Reported within 24 hours of delivery for damaged, defective, or incorrect items to <a href="mailto:indiacontact.faberelin@gmail.com" style="color: #7E3E25; font-weight: 600;">indiacontact.faberelin@gmail.com</a>.</p>
                  <p><strong>Cancellations:</strong> Within 12 hours of placing the order before dispatch.</p>
                  <div style="margin-top: 0.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a href="/policies/shipping-policy" class="footer-link" style="color: #7E3E25; font-weight: 700; font-size: 0.75rem;">Shipping Policy &rarr;</a>
                    <a href="/policies/refund-policy" class="footer-link" style="color: #7E3E25; font-weight: 700; font-size: 0.75rem;">Refund Policy &rarr;</a>
                  </div>
                </div>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Size Guide Modal -->
<div class="modal-dialog" id="SizeGuideModal" role="dialog" aria-modal="true" aria-labelledby="SizeGuideHeading">
  <div class="modal-backdrop" data-action="close-modal"></div>
  <div class="modal-card">
    <button class="modal-close-btn" data-action="close-modal" aria-label="Close modal">✕</button>
    <h3 id="SizeGuideHeading" class="font-sans" style="font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--spacing-xs);">
      Garment Measurement Guide
    </h3>
    <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--spacing-sm);">
      Measurements are taken with the garment laid flat.
    </p>

    <div style="display: flex; gap: var(--spacing-2xs); margin-bottom: var(--spacing-sm);">
      <button class="filter-pill is-active" data-unit-switch="in">INCHES</button>
      <button class="filter-pill" data-unit-switch="cm">CENTIMETERS</button>
    </div>

    <table class="size-table">
      <thead>
        <tr>
          <th>Size</th>
          <th>Chest (Pit-to-Pit)</th>
          <th>Length</th>
          <th>Shoulder</th>
          <th>Sleeve</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>S</strong></td>
          <td data-val-in="21.5&quot;" data-val-cm="54.6 cm">21.5"</td>
          <td data-val-in="28.0&quot;" data-val-cm="71.1 cm">28.0"</td>
          <td data-val-in="19.0&quot;" data-val-cm="48.3 cm">19.0"</td>
          <td data-val-in="24.5&quot;" data-val-cm="62.2 cm">24.5"</td>
        </tr>
        <tr>
          <td><strong>M</strong></td>
          <td data-val-in="22.5&quot;" data-val-cm="57.2 cm">22.5"</td>
          <td data-val-in="29.0&quot;" data-val-cm="73.7 cm">29.0"</td>
          <td data-val-in="19.7&quot;" data-val-cm="50.0 cm">19.7"</td>
          <td data-val-in="25.0&quot;" data-val-cm="63.5 cm">25.0"</td>
        </tr>
        <tr>
          <td><strong>L</strong></td>
          <td data-val-in="23.5&quot;" data-val-cm="59.7 cm">23.5"</td>
          <td data-val-in="30.0&quot;" data-val-cm="76.2 cm">30.0"</td>
          <td data-val-in="20.5&quot;" data-val-cm="52.1 cm">20.5"</td>
          <td data-val-in="25.5&quot;" data-val-cm="64.8 cm">25.5"</td>
        </tr>
        <tr>
          <td><strong>XL</strong></td>
          <td data-val-in="25.0&quot;" data-val-cm="63.5 cm">25.0"</td>
          <td data-val-in="31.0&quot;" data-val-cm="78.7 cm">31.0"</td>
          <td data-val-in="21.5&quot;" data-val-cm="54.6 cm">21.5"</td>
          <td data-val-in="26.0&quot;" data-val-cm="66.0 cm">26.0"</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Main Product (Standard)",
  "settings": [
    {
      "type": "select",
      "id": "column_ratio",
      "label": "Desktop Column Width Ratio",
      "options": [
        { "value": "split-standard", "label": "58% Gallery / 42% Purchase Rail (Standard)" },
        { "value": "split-equal", "label": "50% Gallery / 50% Purchase Rail (Balanced)" },
        { "value": "split-wide-gallery", "label": "68% Gallery / 32% Purchase Rail (Wide Editorial)" }
      ],
      "default": "split-standard"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge Pill",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "NEW ARRIVAL"
    },
    {
      "type": "image_picker",
      "id": "image_detail_1",
      "label": "Secondary Image 1 (Folded/Detail)"
    },
    {
      "type": "image_picker",
      "id": "image_detail_2",
      "label": "Secondary Image 2 (Context/Look)"
    },
    {
      "type": "image_picker",
      "id": "image_macro",
      "label": "Macro Texture Image"
    }
  ],
  "presets": [
    {
      "name": "Main Product (Standard)"
    }
  ]
}
{% endschema %}
