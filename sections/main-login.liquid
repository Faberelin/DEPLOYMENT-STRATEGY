{% comment %}
  Main Customer Login Section - Stratos Shopify Theme
  Section-based customer authentication supporting login, recover password, and guest checkout.
  Follows Shopify Theme 2.0 schema architecture with dynamic settings and image_url attributes.
{% endcomment %}

<section class="auth-section" data-section-id="{{ section.id }}" data-section-type="main-login">
  <div class="container">
    <div class="auth-grid {% if section.settings.show_editorial_image %}has-image{% endif %}">
      
      {%- if section.settings.show_editorial_image -%}
        <div class="auth-editorial-column">
          {%- if section.settings.editorial_image != blank -%}
            <img
              src="{{ section.settings.editorial_image | image_url: width: 1000 }}"
              alt="{{ section.settings.editorial_image.alt | default: section.settings.heading | escape }}"
              width="{{ section.settings.editorial_image.width | default: 800 }}"
              height="{{ section.settings.editorial_image.height | default: 1000 }}"
              loading="lazy"
              class="auth-editorial-img"
            >
          {%- else -%}
            <img
              src="https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=1000&q=85"
              alt="{{ section.settings.heading | escape }}"
              width="800"
              height="1000"
              loading="lazy"
              class="auth-editorial-img"
            >
          {%- endif -%}
          <div class="auth-editorial-overlay">
            <div class="auth-editorial-caption">
              <span class="auth-caption-eyebrow">{{ section.settings.image_eyebrow | default: 'FABERELIN ATELIER' }}</span>
              <p class="auth-caption-quote">{{ section.settings.image_quote | default: 'Dedicated to intentional living and timeless silhouettes.' }}</p>
            </div>
          </div>
        </div>
      {%- endif -%}

      <div class="auth-form-column">
        
        <!-- ===================================================================
             01. LOGIN FORM
             =================================================================== -->
        <div id="CustomerLoginForm" class="auth-card is-active">
          <div class="auth-header">
            <span class="auth-eyebrow">{{ section.settings.eyebrow | default: 'CLIENT PORTAL' }}</span>
            <h1 class="auth-title font-sans">{{ section.settings.heading | default: 'Sign In to Your Account' }}</h1>
            <p class="auth-deck">{{ section.settings.subheading | default: 'Access your order history, carbon offset certificates, and tailored sizing recommendations.' }}</p>
          </div>

          {%- form 'customer_login', class: 'auth-form' -%}
            {%- if form.errors -%}
              <div class="auth-error-banner" role="alert">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <div class="auth-success-banner" role="status">
                <span>{{ section.settings.reset_success_msg | default: 'Password reset link sent. Please check your inbox.' }}</span>
              </div>
            {%- endif -%}

            <div class="auth-field">
              <label for="CustomerEmail-{{ section.id }}" class="auth-label">{{ section.settings.email_label | default: 'EMAIL ADDRESS' }}</label>
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail-{{ section.id }}"
                class="auth-input"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.email_placeholder | default: 'name@domain.com' }}"
                required
              >
            </div>

            {%- if form.password_needed -%}
              <div class="auth-field">
                <div class="auth-field-header">
                  <label for="CustomerPassword-{{ section.id }}" class="auth-label">{{ section.settings.password_label | default: 'PASSWORD' }}</label>
                  <a href="#recover" class="auth-link-forgot" id="RecoverPasswordTrigger">{{ section.settings.forgot_password_text | default: 'Forgot Password?' }}</a>
                </div>
                <input
                  type="password"
                  name="customer[password]"
                  id="CustomerPassword-{{ section.id }}"
                  class="auth-input"
                  autocomplete="current-password"
                  placeholder="{{ section.settings.password_placeholder | default: '••••••••' }}"
                  required
                >
              </div>
            {%- endif -%}

            <div class="auth-actions">
              <button type="submit" class="btn-primary auth-submit-btn">
                <span>{{ section.settings.submit_btn_text | default: 'SIGN IN' }}</span>
              </button>
            </div>

            <div class="auth-footer-nav">
              <span class="auth-footer-text">{{ section.settings.no_account_text | default: "Don't have an account?" }}</span>
              <a href="{{ routes.account_register_url }}" class="auth-link-primary">
                {{ section.settings.create_account_text | default: 'Create Account' }}
              </a>
            </div>
          {%- endform -%}

          {%- if shop.checkout.guest_login -%}
            <div class="auth-guest-section">
              <div class="auth-divider">
                <span>{{ section.settings.guest_divider_text | default: 'OR' }}</span>
              </div>
              {%- form 'guest_login' -%}
                <button type="submit" class="btn-secondary auth-guest-btn">
                  {{ section.settings.guest_btn_text | default: 'Continue as Guest' }}
                </button>
              {%- endform -%}
            </div>
          {%- endif -%}
        </div>

        <!-- ===================================================================
             02. RECOVER PASSWORD FORM
             =================================================================== -->
        <div id="RecoverPasswordForm" class="auth-card is-hidden">
          <div class="auth-header">
            <span class="auth-eyebrow">{{ section.settings.recover_eyebrow | default: 'ACCOUNT RECOVERY' }}</span>
            <h2 class="auth-title font-sans">{{ section.settings.recover_heading | default: 'Reset Your Password' }}</h2>
            <p class="auth-deck">{{ section.settings.recover_subheading | default: 'Enter the email address associated with your Faberelin account and we will send you a reset link.' }}</p>
          </div>

          {%- form 'recover_customer_password', class: 'auth-form' -%}
            {%- if form.errors -%}
              <div class="auth-error-banner" role="alert">
                <span>{{ form.errors | default_errors }}</span>
              </div>
            {%- endif -%}

            <div class="auth-field">
              <label for="RecoverEmail-{{ section.id }}" class="auth-label">{{ section.settings.email_label | default: 'EMAIL ADDRESS' }}</label>
              <input
                type="email"
                name="email"
                id="RecoverEmail-{{ section.id }}"
                class="auth-input"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="{{ section.settings.email_placeholder | default: 'name@domain.com' }}"
                required
              >
            </div>

            <div class="auth-actions">
              <button type="submit" class="btn-primary auth-submit-btn">
                <span>{{ section.settings.recover_submit_btn_text | default: 'SEND RESET LINK' }}</span>
              </button>
              <button type="button" class="btn-secondary auth-cancel-btn" id="CancelRecoverTrigger">
                <span>{{ section.settings.recover_cancel_btn_text | default: 'Cancel' }}</span>
              </button>
            </div>
          {%- endform -%}
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var recoverTrigger = document.getElementById('RecoverPasswordTrigger');
    var cancelTrigger = document.getElementById('CancelRecoverTrigger');
    var loginForm = document.getElementById('CustomerLoginForm');
    var recoverForm = document.getElementById('RecoverPasswordForm');

    if (recoverTrigger && cancelTrigger && loginForm && recoverForm) {
      recoverTrigger.addEventListener('click', function (e) {
        e.preventDefault();
        loginForm.classList.remove('is-active');
        loginForm.classList.add('is-hidden');
        recoverForm.classList.remove('is-hidden');
        recoverForm.classList.add('is-active');
      });

      cancelTrigger.addEventListener('click', function (e) {
        e.preventDefault();
        recoverForm.classList.remove('is-active');
        recoverForm.classList.add('is-hidden');
        loginForm.classList.remove('is-hidden');
        loginForm.classList.add('is-active');
      });

      if (window.location.hash === '#recover') {
        loginForm.classList.remove('is-active');
        loginForm.classList.add('is-hidden');
        recoverForm.classList.remove('is-hidden');
        recoverForm.classList.add('is-active');
      }
    }
  });
</script>

