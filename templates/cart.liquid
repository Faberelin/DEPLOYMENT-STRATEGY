{% comment %}
  Cart Template - Stratos Theme
{% endcomment %}

<section class="container" style="padding-block: var(--spacing-2xl);">
  <div style="max-width: 680px; margin-inline: auto; text-align: center;">
    <h1 class="font-sans" style="font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--spacing-md);">Your Bag</h1>
    <p style="color: var(--color-text-muted); margin-bottom: var(--spacing-lg);">Review your selected garments before proceeding to carbon-neutral checkout.</p>
    <button class="btn-primary" data-action="open-cart" style="max-width: 260px; margin-inline: auto;">
      OPEN SLIDE-OUT BAG
    </button>
  </div>
</section>
